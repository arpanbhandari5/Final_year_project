# ─────────────────────────────────────────────────────────────
# Prayash — Environment Configuration Template
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NOTE: .env is in .gitignore — your secrets will NOT be
# committed to version control.
# ─────────────────────────────────────────────────────────────

# ── Flask ───────────────────────────────────────────────────
# REQUIRED: Change this to a long random string in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY="change-me-to-a-long-random-string"

# ── Environment Mode ────────────────────────────────────────
# Set to "production" to enable HTTPS-only OAuth and secure cookies.
# Defaults to "development" if not set.
# FLASK_ENV="production"

# ── Google OAuth ─────────────────────────────────────────────
# REQUIRED for Google Sign-In to work
# How to set up:
#   1. Go to https://console.cloud.google.com/apis/credentials
#   2. Create or edit OAuth 2.0 Client ID (Web application)
#   3. Add BOTH of these Authorised redirect URIs:
#      - http://localhost:5000/login/google/authorized
#      - http://127.0.0.1:5000/login/google/authorized
#      WARNING: 'localhost' and '127.0.0.1' are DIFFERENT in Google Cloud Console!
#   4. Copy the Client ID & Client Secret below
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# ── GitHub OAuth (optional) ─────────────────────────────────
# 1. Go to https://github.com/settings/developers
# 2. New OAuth App -> callback URL: http://localhost:5000/login/github/authorized
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""

# ── LinkedIn OAuth (optional) ────────────────────────────────
# Requires LinkedIn API partnership approval.
# Redirect URI: http://localhost:5000/login/linkedin/authorized
LINKEDIN_OAUTH_CLIENT_ID=""
LINKEDIN_OAUTH_CLIENT_SECRET=""

# ── Database ─────────────────────────────────────────────────
# Uses SQLite by default at instance/prayash.db.
# Change to PostgreSQL in production:
# DATABASE_URL="postgresql://user:pass@host:5432/prayash"

# ── Admin Account ────────────────────────────────────────────
ADMIN_EMAIL="admin@prayash.local"
ADMIN_PASSWORD="prayash-admin"

# ── Ollama (Local AI fallback for advanced narrative) ─────────
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3"

# ── SMTP (Optional - for sending verification/password reset emails) ──
# Uses standard library smtplib. No additional packages needed.
# For Gmail: enable 2FA and create an App Password at:
#   https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM_EMAIL="noreply@prayash.local"
SMTP_FROM_NAME="Prayash"

# ── Email (Flask-Mail) ─────────────────────────────────────────
# Preferred transport for verification & password-reset OTP emails.
# These override the legacy SMTP_* settings above.
#
# Gmail setup:
#   1. Enable 2-Step Verification: https://myaccount.google.com/security
#   2. Create an App Password:     https://myaccount.google.com/apppasswords
#   3. Set MAIL_USERNAME to your Gmail address and MAIL_PASSWORD to the
#      generated 16-character App Password.
#   4. MAIL_FROM_EMAIL MUST equal MAIL_USERNAME (Gmail rejects From
#      addresses you don't own).
# NOTE: while MAIL_USERNAME/MAIL_PASSWORD are empty, OTP emails are only
# logged to the console and are NOT delivered.
MAIL_SERVER="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USE_TLS="true"
MAIL_USE_SSL="false"
MAIL_USERNAME=""          # your@gmail.com
MAIL_PASSWORD=""          # 16-character Gmail App Password
MAIL_FROM_EMAIL=""        # same as MAIL_USERNAME
MAIL_FROM_NAME="Prayash"
MAIL_DEFAULT_SENDER="Prayash <noreply@prayash.local>"
